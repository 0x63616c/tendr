require "digest"
require "net/http"
require "shellwords"

default_platform(:ios)

APP_IDENTIFIER = "com.calumwebb.still"
APP_VERSION = "1.0.1"
INTERNAL_GROUP = "Owner Preview"
BETA_DESCRIPTION = "Tendr is a private, local-first companion for tracking doses, medication levels, vials, weight, schedules, and progress."
BETA_FEEDBACK_EMAIL = ENV.fetch("ASC_BETA_FEEDBACK_EMAIL")
METADATA_PATH = "./fastlane/metadata"
SCREENSHOTS_PATH = "./fastlane/screenshots"
# Consumable tips; must match Still/Features/Journal/TipJar.swift and Tendr.storekit.
TIPS = [
  { product_id: "com.calumwebb.still.tip.small", reference: "Tip: Coffee", name: "Coffee", description: "A small tip to support Tendr.", price: "0.99" },
  { product_id: "com.calumwebb.still.tip.medium", reference: "Tip: Croissant", name: "Croissant", description: "A medium tip to support Tendr.", price: "2.99" },
  { product_id: "com.calumwebb.still.tip.large", reference: "Tip: Gift", name: "Gift", description: "A generous tip to support Tendr.", price: "4.99" }
].freeze
TIP_REVIEW_NOTE = "An optional tip from Settings > Support Tendr. It unlocks nothing; the app is fully free."
TIP_REVIEW_SCREENSHOT = File.expand_path("iap/tip-sheet-review.png", __dir__)

private_lane :connect_api_key do
  key_path = ENV["ASC_KEY_PATH"]
  key_content = ENV["ASC_KEY_CONTENT"]
  UI.user_error!("Set ASC_KEY_PATH or ASC_KEY_CONTENT") if key_path.to_s.empty? && key_content.to_s.empty?

  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: key_path,
    key_content: key_content
  )
end

platform :ios do
  desc "Run the fast core test suite"
  lane :verify do
    sh("swift", "test")
  end

  desc "Run the full end-to-end simulator suite when UI behavior changes"
  lane :ui do
    run_tests(
      project: "Still.xcodeproj",
      scheme: "Still",
      devices: [ENV.fetch("TENDR_SIMULATOR", "Tend iPhone 17 Pro Max")],
      result_bundle: true,
      number_of_retries: 1,
      output_directory: "build/fastlane/tests"
    )
  end

  desc "Assign an already processed build to Owner Preview"
  lane :distribute_existing do |options|
    build_number = options[:build]
    UI.user_error!("Pass a build number, for example: fastlane ios distribute_existing build:12") if build_number.to_s.empty?

    upload_to_testflight(
      api_key: connect_api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      app_version: options[:version] || APP_VERSION,
      build_number: build_number.to_s,
      distribute_only: true,
      distribute_external: false,
      submit_beta_review: false,
      groups: [INTERNAL_GROUP],
      skip_waiting_for_build_processing: false,
      beta_app_description: BETA_DESCRIPTION,
      beta_app_feedback_email: BETA_FEEDBACK_EMAIL
    )
  end

  desc "Test, build, upload, wait, and distribute the next internal beta"
  lane :beta do |options|
    verify unless options[:skip_tests]
    api_key = connect_api_key
    version = options[:version] || APP_VERSION
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: version,
      initial_build_number: 0
    ) + 1

    xcargs = "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}"
    export_options = {}
    profile_uuid = ENV["TENDR_PROFILE_UUID"]
    if ENV["GITHUB_ACTIONS"] == "true"
      # Xcode-managed profiles cannot be used with manual archive signing.
      # sigh selects an installed certificate and owns this separate profile.
      profile_uuid = get_provisioning_profile(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        provisioning_name: "Tendr CI App Store",
        ignore_profiles_with_different_name: true,
        output_path: ENV.fetch("RUNNER_TEMP"),
        filename: "tendr.mobileprovision"
      )
      UI.user_error!("CI provisioning did not return a profile UUID") if profile_uuid.to_s.empty?
    end
    unless profile_uuid.to_s.empty?
      # CI uses the sigh profile; local Xcode signing stays automatic.
      xcargs += " CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_uuid)}"
      export_options = {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { APP_IDENTIFIER => profile_uuid }
      }
    end

    build_app(
      project: "Still.xcodeproj",
      scheme: "Still",
      clean: true,
      export_method: "app-store",
      output_directory: "build/fastlane",
      output_name: "Tendr-#{version}-#{build_number}.ipa",
      xcargs: xcargs,
      export_options: export_options,
      export_xcargs: profile_uuid.to_s.empty? ? "-allowProvisioningUpdates" : ""
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      build_number: build_number.to_s,
      groups: [INTERNAL_GROUP],
      distribute_external: false,
      submit_beta_review: false,
      skip_waiting_for_build_processing: false,
      beta_app_description: BETA_DESCRIPTION,
      beta_app_feedback_email: BETA_FEEDBACK_EMAIL,
      changelog: options[:changelog] || "Small interface refinements and reliability improvements."
    )
  end

  desc "Upload the App Store listing and screenshots. Never uploads a binary or submits for review"
  lane :metadata do |options|
    # Contact details that should not live in the repository come from the environment.
    review_contact = {
      phone_number: ENV["ASC_REVIEW_PHONE"],
      email_address: ENV["ASC_REVIEW_EMAIL"]
    }.reject { |_, value| value.to_s.empty? }

    guard_first_review_detail
    deliver(
      api_key: options[:api_key] || connect_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: options[:version] || APP_VERSION,
      platform: "ios",
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_screenshots: options[:skip_screenshots].to_s == "true",
      overwrite_screenshots: true,
      app_review_information: review_contact,
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Attach the newest processed, unexpired TestFlight build of the version to the App Store version"
  lane :select_build do |options|
    connect_api_key
    version = options[:version] || APP_VERSION
    app = app_store_app
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, processing_states: "VALID", sort: "-uploadedDate")
                                        .reject(&:expired)
                                        .max_by { |candidate| candidate.version.to_i }
    UI.user_error!("No processed, unexpired #{version} build in App Store Connect. Wait for TestFlight processing, then rerun.") unless build

    app_store_version = editable_app_store_version(app)
    if app_store_version.build&.id == build.id
      UI.success("#{version} (#{build.version}) is already selected for review")
    else
      app_store_version.select_build(build_id: build.id)
      UI.success("Selected #{version} (#{build.version}), uploaded #{build.uploaded_date}, for review")
    end
  end

  desc "Make the app free in every territory if it has no price yet. An existing price is left alone"
  lane :ensure_free_pricing do
    connect_api_key
    app = app_store_app
    asc = Spaceship::ConnectAPI.client.tunes_request_client
    schedule = begin
      asc.get("v1/apps/#{app.id}/appPriceSchedule").body["data"]
    rescue StandardError
      nil
    end
    if schedule
      prices = asc.get("v1/appPriceSchedules/#{schedule['id']}/manualPrices", { include: "appPricePoint", limit: 50 }).body
      amounts = (prices["included"] || []).map { |point| point.dig("attributes", "customerPrice") }.uniq
      UI.success("Price already set (base price #{amounts.join(', ')}); leaving it unchanged")
      next
    end

    free = nil
    page = asc.get("v1/apps/#{app.id}/appPricePoints", { filter: { territory: "USA" }, limit: 200 }).body
    loop do
      free = page["data"].find { |point| point.dig("attributes", "customerPrice").to_f.zero? }
      next_page = page.dig("links", "next")
      break if free || next_page.nil?
      page = asc.get(next_page).body
    end
    UI.user_error!("App Store Connect returned no free price point") unless free

    asc.post("v1/appPriceSchedules", {
      data: {
        type: "appPriceSchedules",
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          baseTerritory: { data: { type: "territories", id: "USA" } },
          manualPrices: { data: [{ type: "appPrices", id: "${free}" }] }
        }
      },
      included: [{
        type: "appPrices",
        id: "${free}",
        attributes: { startDate: nil },
        relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } }
      }]
    })
    UI.success("Set the price to Free")
  end

  desc "Print what App Store Connect currently has for the editable version"
  lane :review_status do
    connect_api_key
    app = app_store_app
    app_store_version = editable_app_store_version(app)
    localization = app_store_version.get_app_store_version_localizations.find { |item| item.locale == "en-US" }
    sets = localization ? localization.get_app_screenshot_sets : []
    review = begin
      app_store_version.fetch_app_store_review_detail
    rescue StandardError
      nil
    end
    info = app.fetch_edit_app_info || app.fetch_latest_app_info
    rows = {
      "App" => "#{app.name} (#{app.id})",
      "Version" => "#{app_store_version.version_string}, #{app_store_version.app_store_state}",
      "Build" => app_store_version.build ? "#{app_store_version.build.version} (#{app_store_version.build.processing_state})" : "none selected",
      "Screenshots" => sets.map { |set| "#{set.screenshot_display_type}: #{set.app_screenshots.to_a.count}" }.join(", ").then { |value| value.empty? ? "none" : value },
      "Subtitle" => info&.get_app_info_localizations&.find { |item| item.locale == "en-US" }&.subtitle,
      "Primary category" => info&.primary_category&.id,
      "Review contact" => review ? [review.contact_first_name, review.contact_last_name, review.contact_email, review.contact_phone.to_s.empty? ? "phone missing" : "phone set"].compact.join(", ") : "none",
      "Copyright" => app_store_version.copyright
    }
    rows.each { |label, value| UI.message("#{label}: #{value}") }
    summary = ENV["GITHUB_STEP_SUMMARY"]
    if summary
      File.open(summary, "a") do |file|
        file.puts("### App Store Connect\n\n| | |\n| --- | --- |")
        rows.each { |label, value| file.puts("| #{label} | #{value.to_s.gsub('|', '/')} |") }
      end
    end
  end

  desc "Answer the age rating questionnaire: nothing applies except infrequent/mild medical information"
  lane :age_rating do
    connect_api_key
    app = app_store_app
    info = app.fetch_edit_app_info || app.fetch_latest_app_info
    asc = Spaceship::ConnectAPI.client.tunes_request_client
    declaration = asc.get("v1/appInfos/#{info.id}/ageRatingDeclaration").body["data"]
    current = declaration["attributes"] || {}
    UI.message("Current age rating answers: #{current.to_json}")
    none = %w[alcoholTobaccoOrDrugUseOrReferences contests gamblingSimulated gunsOrOtherWeapons profanityOrCrudeHumor
              sexualContentGraphicAndNudity sexualContentOrNudity horrorOrFearThemes matureOrSuggestiveThemes
              violenceCartoonOrFantasy violenceRealisticProlongedGraphicOrSadistic violenceRealistic]
    no = %w[advertising ageAssurance gambling healthOrWellnessTopics lootBox messagingAndChat parentalControls
            socialMedia socialMediaAgeRestricted unrestrictedWebAccess userGeneratedContent]
    wanted = {}
    none.each { |key| wanted[key] = "NONE" if current.key?(key) }
    no.each { |key| wanted[key] = false if current.key?(key) }
    wanted["medicalOrTreatmentInformation"] = "INFREQUENT_OR_MILD"
    UI.message("Setting age rating answers: #{wanted.to_json}")
    updated = asc.patch("v1/ageRatingDeclarations/#{declaration['id']}", {
      data: { type: "ageRatingDeclarations", id: declaration["id"], attributes: wanted }
    }).body["data"]["attributes"]
    UI.success("Age rating answers now: #{updated.to_json}")
  end

  desc "Make sure App Review does not expect a demo account"
  lane :review_detail_check do
    connect_api_key
    version = editable_app_store_version(app_store_app)
    detail = version.fetch_app_store_review_detail
    UI.user_error!("No App Review details yet") unless detail
    if detail.demo_account_required
      Spaceship::ConnectAPI.client.tunes_request_client.patch("v1/appStoreReviewDetails/#{detail.id}", {
        data: { type: "appStoreReviewDetails", id: detail.id, attributes: { demoAccountRequired: false } }
      })
      UI.success("Turned off demo account required")
    end
    detail = version.fetch_app_store_review_detail
    UI.message("Review details: #{detail.contact_first_name} #{detail.contact_last_name}, email #{detail.contact_email.to_s.empty? ? 'missing' : 'set'}, phone #{detail.contact_phone.to_s.empty? ? 'missing' : 'set'}, demo account required #{detail.demo_account_required.inspect}, notes #{detail.notes.to_s.length} chars")
  end

  desc "Upload the listing and screenshots, set Free pricing and attach the latest build. Stops before Submit for Review"
  desc "Create or update the three consumable tips (name, price, availability, review screenshot). Never submits"
  lane :tip_iaps do
    connect_api_key
    app = app_store_app
    asc = Spaceship::ConnectAPI.client.tunes_request_client
    territories = asc_all(asc, "v1/territories", { "limit" => 200 }).map { |territory| territory["id"] }
    existing = asc_all(asc, "v1/apps/#{app.id}/inAppPurchasesV2", { "limit" => 200 })
    TIPS.each do |tip|
      iap = existing.find { |item| item.dig("attributes", "productId") == tip[:product_id] }
      if iap
        UI.message("#{tip[:product_id]} exists (#{iap.dig('attributes', 'state')})")
      else
        iap = asc.post("v2/inAppPurchases", { data: {
          type: "inAppPurchases",
          attributes: { name: tip[:reference], productId: tip[:product_id], inAppPurchaseType: "CONSUMABLE", reviewNote: TIP_REVIEW_NOTE, familySharable: false },
          relationships: { app: { data: { type: "apps", id: app.id } } }
        } }).body["data"]
        UI.success("Created #{tip[:product_id]}")
      end
      id = iap["id"]
      tip_localization(asc, id, tip)
      tip_price(asc, id, tip)
      tip_availability(asc, id, territories)
      tip_review_screenshot(asc, id)
      state = asc.get("v2/inAppPurchases/#{id}").body.dig("data", "attributes", "state")
      UI.success("#{tip[:product_id]}: #{tip[:name]} $#{tip[:price]}, state #{state}")
    end
  end

  lane :prepare_review do |options|
    api_key = connect_api_key
    metadata(api_key: api_key, version: options[:version], skip_screenshots: options[:skip_screenshots])
    begin
      ensure_free_pricing
    rescue StandardError => error
      UI.important("Could not set Free pricing (#{error.message}). Set it under Pricing and Availability in App Store Connect.")
    end
    select_build(version: options[:version])
    age_rating
    review_detail_check
    review_status
  end
end

# Apple only creates App Review details with a contact phone, and deliver 2.239 then assumes they
# exist. Until a phone is known (ASC_REVIEW_PHONE or entered in App Store Connect), skip them and
# let the rest of the listing upload.
module TendrFirstReviewDetail
  def review_information(version)
    existing = begin
      version.fetch_app_store_review_detail
    rescue StandardError
      nil
    end
    if existing.nil? && options[:app_review_information].to_h.transform_keys(&:to_sym)[:phone_number].to_s.strip.empty?
      FastlaneCore::UI.important("Skipping App Review details: Apple needs a contact phone first. Set the ASC_REVIEW_PHONE secret or add it in App Store Connect, then rerun.")
      return
    end
    super
  end

  def review_attachment_file(version)
    super
  rescue RuntimeError => error
    raise unless error.message == "No data"
  end
end

def guard_first_review_detail
  require "deliver"
  Deliver::UploadMetadata.prepend(TendrFirstReviewDetail) unless Deliver::UploadMetadata < TendrFirstReviewDetail
rescue LoadError
  nil
end

def app_store_app
  Spaceship::ConnectAPI::App.find(APP_IDENTIFIER) || UI.user_error!("#{APP_IDENTIFIER} is not in App Store Connect")
end

def editable_app_store_version(app)
  app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS) ||
    UI.user_error!("No editable App Store version. Create one in App Store Connect or run the metadata lane first")
end

# Follows `links.next` so long lists (territories, price points) are complete.
def asc_all(asc, path, params = nil)
  response = asc.get(path, params)
  items = response.body["data"]
  while (next_url = response.body.dig("links", "next"))
    response = asc.get(next_url)
    items += response.body["data"]
  end
  items
end

def tip_localization(asc, id, tip)
  attributes = { name: tip[:name], description: tip[:description] }
  existing = asc_all(asc, "v2/inAppPurchases/#{id}/inAppPurchaseLocalizations").find { |item| item.dig("attributes", "locale") == "en-US" }
  if existing
    asc.patch("v1/inAppPurchaseLocalizations/#{existing['id']}", { data: { type: "inAppPurchaseLocalizations", id: existing["id"], attributes: attributes } })
  else
    asc.post("v1/inAppPurchaseLocalizations", { data: {
      type: "inAppPurchaseLocalizations",
      attributes: attributes.merge(locale: "en-US"),
      relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: id } } }
    } })
  end
end

# POST replaces the schedule, so rerunning is safe. Other territories follow the USA price.
def tip_price(asc, id, tip)
  points = asc_all(asc, "v2/inAppPurchases/#{id}/pricePoints", { "filter[territory]" => "USA", "limit" => 200 })
  point = points.find { |item| format("%.2f", item.dig("attributes", "customerPrice").to_f) == tip[:price] }
  UI.user_error!("No USA price point at $#{tip[:price]} for #{tip[:product_id]}") unless point
  asc.post("v1/inAppPurchasePriceSchedules", {
    data: {
      type: "inAppPurchasePriceSchedules",
      relationships: {
        inAppPurchase: { data: { type: "inAppPurchases", id: id } },
        baseTerritory: { data: { type: "territories", id: "USA" } },
        manualPrices: { data: [{ type: "inAppPurchasePrices", id: "${price}" }] }
      }
    },
    included: [{
      type: "inAppPurchasePrices", id: "${price}", attributes: { startDate: nil },
      relationships: { inAppPurchasePricePoint: { data: { type: "inAppPurchasePricePoints", id: point["id"] } } }
    }]
  })
end

def tip_availability(asc, id, territories)
  asc.get("v2/inAppPurchases/#{id}/inAppPurchaseAvailability")
rescue StandardError
  asc.post("v1/inAppPurchaseAvailabilities", { data: {
    type: "inAppPurchaseAvailabilities",
    attributes: { availableInNewTerritories: true },
    relationships: {
      inAppPurchase: { data: { type: "inAppPurchases", id: id } },
      availableTerritories: { data: territories.map { |territory| { type: "territories", id: territory } } }
    }
  } })
end

def tip_review_screenshot(asc, id)
  existing = begin
    asc.get("v2/inAppPurchases/#{id}/appStoreReviewScreenshot").body["data"]
  rescue StandardError
    nil
  end
  return if existing && existing.dig("attributes", "assetDeliveryState", "state") == "COMPLETE"

  bytes = File.binread(TIP_REVIEW_SCREENSHOT)
  shot = asc.post("v1/inAppPurchaseAppStoreReviewScreenshots", { data: {
    type: "inAppPurchaseAppStoreReviewScreenshots",
    attributes: { fileName: File.basename(TIP_REVIEW_SCREENSHOT), fileSize: bytes.bytesize },
    relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: id } } }
  } }).body["data"]
  shot.dig("attributes", "uploadOperations").each do |operation|
    uri = URI(operation["url"])
    request = Net::HTTPGenericRequest.new(operation["method"], true, true, uri.request_uri)
    operation["requestHeaders"].each { |header| request[header["name"]] = header["value"] }
    request.body = bytes.byteslice(operation["offset"], operation["length"])
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
    UI.user_error!("Review screenshot upload failed: HTTP #{response.code}") unless response.is_a?(Net::HTTPSuccess)
  end
  asc.patch("v1/inAppPurchaseAppStoreReviewScreenshots/#{shot['id']}", { data: {
    type: "inAppPurchaseAppStoreReviewScreenshots", id: shot["id"],
    attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) }
  } })
end
