require "shellwords"

default_platform(:ios)

APP_IDENTIFIER = "com.calumwebb.still"
APP_VERSION = "1.0.0"
INTERNAL_GROUP = "Owner Preview"
BETA_DESCRIPTION = "Tendr is a private, local-first companion for tracking doses, medication levels, vials, weight, schedules, and progress."
BETA_FEEDBACK_EMAIL = ENV.fetch("ASC_BETA_FEEDBACK_EMAIL")

private_lane :connect_api_key do
  key_path = ENV["ASC_KEY_PATH"]
  key_content = ENV["ASC_KEY_CONTENT"]
  UI.user_error!("Set ASC_KEY_PATH or ASC_KEY_CONTENT") if key_path.to_s.empty? && key_content.to_s.empty?

  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: key_path,
    key_content: key_content
  )
end

# POST /v1/appPriceSchedules replaces the schedule, so this is safe to repeat.
private_lane :ensure_free_pricing do |options|
  app = options[:app]
  client = Spaceship::ConnectAPI.client.tunes_request_client
  points = client.get("v1/apps/#{app.id}/appPricePoints", { "filter[territory]" => "USA", "limit" => 200 }).body["data"]
  free = points.find { |point| point.dig("attributes", "customerPrice").to_f.zero? }
  UI.user_error!("No free USA price point for #{APP_IDENTIFIER}") unless free
  client.post("v1/appPriceSchedules", {
    data: {
      type: "appPriceSchedules",
      relationships: {
        app: { data: { type: "apps", id: app.id } },
        baseTerritory: { data: { type: "territories", id: "USA" } },
        manualPrices: { data: [{ type: "appPrices", id: "${free}" }] }
      }
    },
    included: [{
      type: "appPrices",
      id: "${free}",
      attributes: { startDate: nil },
      relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } }
    }]
  })
  UI.success("Price set to Free (USA base territory)")

  begin
    client.get("v2/appAvailabilities/#{app.id}")
    UI.message("App availability already configured; leaving territories unchanged")
  rescue StandardError => error
    UI.message("No app availability yet (#{error.message.lines.first&.strip}); making the app available in all territories")
    territories = client.get("v1/territories", { "limit" => 200 }).body["data"].map { |territory| territory["id"] }
    client.post("v2/appAvailabilities", {
      data: {
        type: "appAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          territoryAvailabilities: { data: territories.map { |id| { type: "territoryAvailabilities", id: "${#{id}}" } } }
        }
      },
      included: territories.map do |id|
        {
          type: "territoryAvailabilities",
          id: "${#{id}}",
          attributes: { available: true },
          relationships: { territory: { data: { type: "territories", id: id } } }
        }
      end
    })
    UI.success("Available in #{territories.count} territories")
  end
end

private_lane :attach_latest_build do |options|
  app = options[:app]
  version = options[:version]
  filter = { "preReleaseVersion.version" => version, processingState: "VALID", expired: false }
  filter[:version] = options[:build].to_s unless options[:build].to_s.empty?
  build = Spaceship::ConnectAPI.get_builds(filter: filter.merge(app: app.id), includes: nil, sort: "-uploadedDate", limit: 1).to_models.first
  UI.user_error!("No processed TestFlight build for #{version}#{" (#{options[:build]})" unless options[:build].to_s.empty?}") unless build

  app_store_version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  UI.user_error!("No editable App Store version for #{APP_IDENTIFIER}") unless app_store_version
  UI.user_error!("Editable App Store version is #{app_store_version.version_string}, expected #{version}") unless app_store_version.version_string == version
  app_store_version.select_build(build_id: build.id)
  UI.success("Attached build #{version} (#{build.version}) to App Store version #{version} [#{app_store_version.app_store_state}]")
  build.version
end

platform :ios do
  desc "Upload the App Store listing and screenshots, set Free pricing, and attach the latest processed build. Never submits for review."
  lane :metadata do |options|
    api_key = connect_api_key
    version = options[:version] || APP_VERSION
    screenshots = Dir[File.join(__dir__, "screenshots", "en-US", "*.png")]
    UI.user_error!("No screenshots in fastlane/screenshots/en-US; run scripts/capture-screenshots.sh and scripts/frame-screenshots.swift") if screenshots.empty? && !options[:skip_screenshots]

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      platform: "ios",
      metadata_path: File.join(__dir__, "metadata"),
      screenshots_path: File.join(__dir__, "screenshots"),
      skip_binary_upload: true,
      skip_screenshots: options[:skip_screenshots] ? true : false,
      # Names and notes come from metadata/review_information; contact details stay out of git.
      app_review_information: {
        email_address: ENV["ASC_REVIEW_EMAIL"].to_s.empty? ? BETA_FEEDBACK_EMAIL : ENV["ASC_REVIEW_EMAIL"],
        phone_number: ENV["ASC_REVIEW_PHONE"]
      }.compact,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    )

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App #{APP_IDENTIFIER} not found in App Store Connect") unless app
    ensure_free_pricing(app: app)
    attach_latest_build(app: app, version: version, build: options[:build]) unless options[:skip_build]
    UI.important("Stopped before Submit for Review. Finish the Age Rating and App Privacy sections, then submit in App Store Connect.")
  end

  desc "Run the fast core test suite"
  lane :verify do
    sh("swift", "test")
  end

  desc "Run the full end-to-end simulator suite when UI behavior changes"
  lane :ui do
    run_tests(
      project: "Still.xcodeproj",
      scheme: "Still",
      devices: [ENV.fetch("TENDR_SIMULATOR", "Tend iPhone 17 Pro Max")],
      result_bundle: true,
      number_of_retries: 1,
      output_directory: "build/fastlane/tests"
    )
  end

  desc "Assign an already processed build to Owner Preview"
  lane :distribute_existing do |options|
    build_number = options[:build]
    UI.user_error!("Pass a build number, for example: fastlane ios distribute_existing build:12") if build_number.to_s.empty?

    upload_to_testflight(
      api_key: connect_api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      app_version: options[:version] || APP_VERSION,
      build_number: build_number.to_s,
      distribute_only: true,
      distribute_external: false,
      submit_beta_review: false,
      groups: [INTERNAL_GROUP],
      skip_waiting_for_build_processing: false,
      beta_app_description: BETA_DESCRIPTION,
      beta_app_feedback_email: BETA_FEEDBACK_EMAIL
    )
  end

  desc "Test, build, upload, wait, and distribute the next internal beta"
  lane :beta do |options|
    verify unless options[:skip_tests]
    api_key = connect_api_key
    version = options[:version] || APP_VERSION
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: version,
      initial_build_number: 0
    ) + 1

    xcargs = "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}"
    export_options = {}
    profile_uuid = ENV["TENDR_PROFILE_UUID"]
    if ENV["GITHUB_ACTIONS"] == "true"
      # Xcode-managed profiles cannot be used with manual archive signing.
      # sigh selects an installed certificate and owns this separate profile.
      profile_uuid = get_provisioning_profile(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        provisioning_name: "Tendr CI App Store",
        ignore_profiles_with_different_name: true,
        output_path: ENV.fetch("RUNNER_TEMP"),
        filename: "tendr.mobileprovision"
      )
      UI.user_error!("CI provisioning did not return a profile UUID") if profile_uuid.to_s.empty?
    end
    unless profile_uuid.to_s.empty?
      # CI uses the sigh profile; local Xcode signing stays automatic.
      xcargs += " CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_uuid)}"
      export_options = {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { APP_IDENTIFIER => profile_uuid }
      }
    end

    build_app(
      project: "Still.xcodeproj",
      scheme: "Still",
      clean: true,
      export_method: "app-store",
      output_directory: "build/fastlane",
      output_name: "Tendr-#{version}-#{build_number}.ipa",
      xcargs: xcargs,
      export_options: export_options,
      export_xcargs: profile_uuid.to_s.empty? ? "-allowProvisioningUpdates" : ""
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      build_number: build_number.to_s,
      groups: [INTERNAL_GROUP],
      distribute_external: false,
      submit_beta_review: false,
      skip_waiting_for_build_processing: false,
      beta_app_description: BETA_DESCRIPTION,
      beta_app_feedback_email: BETA_FEEDBACK_EMAIL,
      changelog: options[:changelog] || "Small interface refinements and reliability improvements."
    )
  end
end
